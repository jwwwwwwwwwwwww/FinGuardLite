@page "/Customers"
@model FinGuardLite.Pages.Customers.IndexModel

@{
    ViewData["Title"] = "Customers";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1>Customers</h1>
        <p class="text-muted mb-0">
            Manage customer profiles used for transaction risk scoring.
        </p>
    </div>

    <a class="btn btn-primary" asp-page="/Customers/Create">Create Customer Profile</a>
</div>

@if (Model.Customers.Any())
{
    <table class="table table-bordered table-striped">
        <thead>
            <tr>
                <th>Customer</th>
                <th>Age</th>
                <th>Monthly Income</th>
                <th>Country</th>
                <th>Risk Profile</th>
                <th>Created At</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var customer in Model.Customers)
            {
                <tr>
                    <td>@customer.FullName</td>
                    <td>@customer.Age</td>
                    <td>$@customer.MonthlyIncome.ToString("N2")</td>
                    <td>@customer.Country</td>
                    <td>
                        @if (customer.RiskProfile == "High")
                        {
                            <span class="badge bg-danger">High</span>
                        }
                        else if (customer.RiskProfile == "Medium")
                        {
                            <span class="badge bg-warning text-dark">Medium</span>
                        }
                        else
                        {
                            <span class="badge bg-success">Low</span>
                        }
                    </td>
                    <td>@customer.CreatedAt.ToString("dd MMM yyyy")</td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <div class="alert alert-info">
        No customers found. Click <strong>Add Customer</strong> to create one.
    </div>
}